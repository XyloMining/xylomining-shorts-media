# Copy to .env (never commit it). Only fill what you use.

# LLM backends (only the one selected in config.yaml is needed)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Notifications (any combination; all optional)
DISCORD_WEBHOOK_URL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_TO=
